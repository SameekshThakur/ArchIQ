# LLM provider: "mock" (built-in narrator, no network) or "azure_openai" (real model).
# Copy this file to backend/.env and fill in the values. backend/.env is git-ignored: never commit a key.
PROVIDER=mock

# Used when PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional tuning
LLM_TIMEOUT=45
LLM_REASONING_EFFORT=low
LLM_VERIFY_NUMBERS=true
